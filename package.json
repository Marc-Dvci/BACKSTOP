{
  "name": "backstop",
  "private": true,
  "version": "1.0.0",
  "description": "Capital-backed verification protocol for hosted AI inference",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter @backstop/core --filter @backstop/sdk --filter @backstop/cli --filter @backstop/producer build",
    "test": "pnpm -r --filter @backstop/core --filter @backstop/sdk --filter @backstop/cli --filter @backstop/producer test",
    "test:indexer": "vitest run --config vitest.indexer.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:cre": "vitest run --config vitest.cre.config.ts",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "gate-zero": "pnpm --filter @backstop/core run gate-zero",
    "vectors": "pnpm --filter @backstop/core run vectors",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "web:dev": "pnpm --filter @backstop/web dev",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "viem": "^2.22.8",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@chainlink/cre-sdk-javy-plugin": "1.7.0",
      "axios@<1.20.0": "1.20.0",
      "postcss@<8.5.23": "8.5.28",
      "sharp@0.35.0": "0.35.5",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
