{
  "name": "@backstop/producer",
  "version": "1.0.0",
  "description": "Evidence producer: terminates the session, signs with an attested key, publishes before the contributor sees the content",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "backstop-producer": "./dist/cli.js" },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@backstop/core": "workspace:*",
    "@backstop/sdk": "workspace:*",
    "viem": "^2.22.8"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsup": "^8.3.5",
    "vitest": "^3.0.5"
  }
}
