                "value",
                "provenance"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "checkpointDigest",
            "tokenizerHash",
            "quantizationRecipe"
          ],
          "additionalProperties": false
        },
        "servingStack": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "provider_declared",
                    "issuer_observed",
                    "issuer_constructed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "provenance"
