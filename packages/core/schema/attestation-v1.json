            "credentialClass": {
              "type": "string",
              "enum": [
                "contributor_enclave",
                "probe_scoped",
                "ephemeral"
              ]
            },
            "geography": {
              "type": "string"
            },
            "normalizationSpec": {
              "type": "string"
            }
          },
          "required": [
            "temperature",
            "topP",
            "topK",
            "maxTokens",
            "stopSequences",
            "seedHandling",
            "systemPrompt",
            "routingHeaders",
            "providerPinning",
            "allowFallbacks",
            "retryPolicy",
            "concurrency",
            "credentialClass",
            "geography",
            "normalizationSpec"
