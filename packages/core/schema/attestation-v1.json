            "checkpointDigest": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "provider_declared",
                    "issuer_observed",
                    "issuer_constructed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "provenance"
              ],
              "additionalProperties": false
            },
            "tokenizerHash": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "provider_declared",
                    "issuer_observed",
                    "issuer_constructed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "provenance"
              ],
              "additionalProperties": false
            },
            "quantizationRecipe": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "provider_declared",
                    "issuer_observed",
                    "issuer_constructed",
                    "unknown"
