            "canonicalArithmeticHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "alphabet": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "cells": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "task": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "task",
                  "language"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
