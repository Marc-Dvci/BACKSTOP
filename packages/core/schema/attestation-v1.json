              "required": [
                "value",
                "provenance"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "engine",
            "containerImageDigest",
            "hardwareProfile"
          ],
          "additionalProperties": false
        },
        "sampling": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number"
            },
            "topP": {
              "type": "number"
            },
            "topK": {
              "type": "integer"
            },
            "maxTokens": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "stopSequences": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "seedHandling": {
              "type": "string",
              "enum": [
                "absent",
                "fixed",
                "per_probe"
              ]
            },
            "systemPrompt": {
              "type": "string"
            },
            "routingHeaders": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "providerPinning": {
              "type": "string"
            },
            "allowFallbacks": {
              "type": "boolean"
            },
            "retryPolicy": {
              "type": "object",
              "properties": {
                "attempts": {
                  "type": "integer"
                },
                "backoffMs": {
                  "type": "integer"
                }
              },
              "required": [
                "attempts",
                "backoffMs"
              ],
              "additionalProperties": false
            },
            "concurrency": {
              "type": "integer",
              "exclusiveMinimum": 0
