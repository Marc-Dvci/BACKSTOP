          "additionalProperties": false
        },
        "envelope": {
          "type": "object",
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "engine": {
                    "type": "string"
                  },
                  "precision": {
                    "type": "string"
                  },
                  "batchProfile": {
                    "type": "string"
                  },
                  "kernelProfile": {
                    "type": "string"
                  }
