{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://backstop.audit/schema/attestation-v1.json",
  "title": "BACKSTOP attestation, version 1",
  "description": "A versioned, hash-referenced, immutable statement of what an endpoint claims to serve and of every parameter the audit will use against it. Every field carries a provenance tag, so a provider-signed attestation and one assembled from observation are distinguishable by machine. An attestation carrying `unknown` for model identity, serving stack or the mixture set is measurement-only and cannot back a policy.",
  "canonicalArithmetic": {
    "spec": "BSA-1|scale=1e27|round=trunc-toward-zero|ln=atanh-10-tab16|exp=taylor-25|ln2=693147180559945309417232121|expmax=88",
    "hash": "0x396a8c70eed71797834c7de8965f1c74fccfd38a8046d9806fb12bcc8bb55366"
  },
  "$ref": "#/definitions/BackstopAttestation",
  "definitions": {
    "BackstopAttestation": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "backstop/attestation@1"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "issuer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "agentId": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "address",
            "agentId"
          ],
          "additionalProperties": false
        },
        "issuedAt": {
          "type": "integer"
        },
        "retiredAt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "retirementReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": "object",
          "properties": {
            "url": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "format": "uri"
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "provider_declared",
                    "issuer_observed",
                    "issuer_constructed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "provenance"
              ],
              "additionalProperties": false
            },
            "modelSlug": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "provider_declared",
                    "issuer_observed",
                    "issuer_constructed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "provenance"
              ],
              "additionalProperties": false
            },
            "contextLength": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "provider_declared",
                    "issuer_observed",
                    "issuer_constructed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "provenance"
              ],
              "additionalProperties": false
            },
            "listPriceMicroUsdPerMTokIn": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "provider_declared",
                    "issuer_observed",
                    "issuer_constructed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "provenance"
              ],
              "additionalProperties": false
            },
            "listPriceMicroUsdPerMTokOut": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "provider_declared",
                    "issuer_observed",
                    "issuer_constructed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "provenance"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "url",
            "modelSlug",
            "contextLength",
            "listPriceMicroUsdPerMTokIn",
            "listPriceMicroUsdPerMTokOut"
          ],
          "additionalProperties": false
        },
        "modelIdentity": {
